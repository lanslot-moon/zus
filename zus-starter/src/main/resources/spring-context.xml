<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xmlns:context="http://www.springframework.org/schema/context"
       xsi:schemaLocation="
           http://www.springframework.org/schema/beans
           http://www.springframework.org/schema/beans/spring-beans.xsd
           http://www.springframework.org/schema/context
           http://www.springframework.org/schema/context/spring-context.xsd">

    <!-- 组件扫描配置：扫描所有模块的包路径（DDD 重构后：无 zus-facade，domain 与 infrastructure 均需扫描） -->
    <context:component-scan base-package="org.kitona.zus.api"/>
    <context:component-scan base-package="org.kitona.zus.service"/>

    <context:component-scan base-package="org.kitona.zus.infrastructure"/>
</beans>
