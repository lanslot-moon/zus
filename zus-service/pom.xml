<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.kitona</groupId>
        <artifactId>zus</artifactId>
        <version>${revision}</version>
    </parent>

    <artifactId>zus-service</artifactId>
    <name>zus-service</name>
    <description>zus-service: 应用层 - 应用服务、用例编排、事务管理、DTO/Command/Query、Assembler、事件监听，协调领域层完成业务流程</description>

    <dependencies>
        <dependency>
            <groupId>org.kitona</groupId>
            <artifactId>zus-domain</artifactId>
        </dependency>

        <dependency>
            <groupId>org.kitona</groupId>
            <artifactId>zus-common</artifactId>
        </dependency>

        <!-- Spring Context: @Service, @Component 等 -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-context</artifactId>
        </dependency>

        <!-- Spring TX: @Transactional, TransactionalEventListener 等 -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-tx</artifactId>
        </dependency>

        <!-- Jakarta Annotation: @Resource 等 -->
        <dependency>
            <groupId>jakarta.annotation</groupId>
            <artifactId>jakarta.annotation-api</artifactId>
        </dependency>

        <!-- Jakarta Validation: JSR-380 参数校验 -->
        <dependency>
            <groupId>jakarta.validation</groupId>
            <artifactId>jakarta.validation-api</artifactId>
        </dependency>
    </dependencies>
</project>
