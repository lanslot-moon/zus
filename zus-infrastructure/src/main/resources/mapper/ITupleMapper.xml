<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.kitona.zus.infrastructure.persistence.mysql.mapper.ITupleMapper">

    <!-- 通用结果映射（与 fga_relation_tuple 表一致） -->
    <resultMap id="BaseResultMap" type="org.kitona.zus.infrastructure.persistence.mysql.entity.TuplePO">
        <id column="id" property="id"/>
        <result column="store_id" property="storeId"/>
        <result column="object_type" property="objectType"/>
        <result column="object_id" property="objectId"/>
        <result column="relation" property="relation"/>
        <result column="subject_type" property="subjectType"/>
        <result column="subject_id" property="subjectId"/>
        <result column="subject_relation" property="subjectRelation"/>
        <result column="is_wildcard" property="isWildcard"/>
        <result column="zookie" property="zookie"/>
        <result column="condition_definition_id" property="conditionDefinitionId"/>
        <result column="condition_name" property="conditionName"/>
        <result column="condition_context" property="conditionContext"/>
        <result column="expires_at" property="expiresAt"/>
        <result column="tenant_id" property="tenantId"/>
        <result column="create_time" property="createTime"/>
        <result column="is_deleted" property="isDeleted"/>
    </resultMap>

    <!-- 批量插入元组 -->
    <insert id="batchInsert">
        INSERT INTO fga_relation_tuple
            (id, store_id, object_type, object_id, relation, subject_type, subject_id,
             subject_relation, is_wildcard, zookie, condition_definition_id, condition_name, condition_context, expires_at, tenant_id, create_time, is_deleted)
        VALUES
        <foreach collection="list" item="item" separator=",">
            (#{item.id}, #{item.storeId}, #{item.objectType}, #{item.objectId}, #{item.relation},
             #{item.subjectType}, #{item.subjectId}, #{item.subjectRelation}, #{item.isWildcard},
             #{item.zookie}, #{item.conditionDefinitionId}, #{item.conditionName}, #{item.conditionContext}, #{item.expiresAt}, #{item.tenantId},
             #{item.createTime}, 0)
        </foreach>
    </insert>

</mapper>
