<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.kitona.zus.infrastructure.persistence.mysql.mapper.IChangelogMapper">

    <!-- 通用结果映射（与 fga_tuple_changelog 表一致） -->
    <resultMap id="BaseResultMap" type="org.kitona.zus.infrastructure.persistence.mysql.entity.TupleChangelogPO">
        <id column="id" property="id"/>
        <result column="store_id" property="storeId"/>
        <result column="zookie" property="zookie"/>
        <result column="operation" property="operation"/>
        <result column="object_type" property="objectType"/>
        <result column="object_id" property="objectId"/>
        <result column="relation" property="relation"/>
        <result column="subject_type" property="subjectType"/>
        <result column="subject_id" property="subjectId"/>
        <result column="subject_relation" property="subjectRelation"/>
        <result column="operator_id" property="operatorId"/>
        <result column="request_id" property="requestId"/>
        <result column="source" property="source"/>
        <result column="operation_time" property="operationTime"/>
    </resultMap>

    <insert id="batchInsert">
        INSERT INTO fga_tuple_changelog
            (id, store_id, zookie, operation, object_type, object_id, relation,
             subject_type, subject_id, subject_relation, operator_id, request_id, source, operation_time)
        VALUES
        <foreach collection="list" item="item" separator=",">
            (#{item.id}, #{item.storeId}, #{item.zookie}, #{item.operation}, #{item.objectType}, #{item.objectId},
             #{item.relation}, #{item.subjectType}, #{item.subjectId}, #{item.subjectRelation},
             #{item.operatorId}, #{item.requestId}, #{item.source}, #{item.operationTime})
        </foreach>
    </insert>

</mapper>
