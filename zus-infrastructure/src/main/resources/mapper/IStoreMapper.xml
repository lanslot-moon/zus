<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.kitona.zus.infrastructure.persistence.mysql.mapper.IStoreMapper">

    <!-- 通用结果映射（与 fga_store 表结构一致） -->
    <resultMap id="BaseResultMap" type="org.kitona.zus.infrastructure.persistence.mysql.entity.StorePO">
        <id column="id" property="id"/>
        <result column="store_id" property="storeId"/>
        <result column="name" property="name"/>
        <result column="description" property="description"/>
        <result column="current_model_id" property="currentModelId"/>
        <result column="current_zookie" property="currentZookie"/>
        <result column="status" property="status"/>
        <result column="tenant_id" property="tenantId"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
        <result column="is_deleted" property="isDeleted"/>
    </resultMap>

    <!-- 原子递增 Zookie -->
    <update id="incrementZookie">
        UPDATE fga_store
        SET current_zookie = current_zookie + 1,
            update_time = #{updateTime}
        WHERE store_id = #{storeId}
          AND is_deleted = 0
          AND status = 0
    </update>

</mapper>
